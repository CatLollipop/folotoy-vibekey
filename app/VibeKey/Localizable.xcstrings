        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        }
      }
    },
    "重新检测": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        }
      }
    },
    "重新读取": {
