    },
    "镜像路径无效：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "invalid image path: %@"
          }
        }
      }
    },
    "长按上键切换 听写 / 翻译 / 字幕；长按下键：%@；录音时长按下键取消。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Up to switch between Dictate, Translate and Captions. Hold Down: %@. While recording, hold Down to cancel."
          }
        }
      }
    },
    "长按电源键 0.5 秒开机": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the power button for half a second to turn it on"
          }
        }
      }
    },
    "长按设备下键选择应用；Agent 应用还可以继续选项目和会话。按住 OK 时会自动切换到所选应用和输入框，同时开始收音。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Down on the device to choose an app; for agents you can then pick a project and session. Holding OK starts capturing audio while bringing the selected app and its input into focus."
          }
        }
      }
    },
    "阿里云百炼 · Fun-ASR 实时识别": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alibaba Cloud Model Studio · Fun-ASR Realtime"
          }
        }
      }
    },
    "需联网 · 按量计费": {
