        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload a photo. Your Mac crops it to 240×320, pixelates it, converts it to green monochrome, and darkens the top and bottom so the status bar, clock, and date stay readable. The original is processed only in memory; the device restarts once after applying."
          }
        }
      }
    },
