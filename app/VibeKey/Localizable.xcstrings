          "stringUnit": {
            "state": "translated",
            "value": "Lock (clicks pass through; unlock from the menu)"
          }
        }
      }
    },
    "镜像写入范围重叠：%@、%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "image write ranges overlap: %1$@, %2$@"
          }
        }
