{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "\n…（完整回复请在电脑查看）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… (View the full reply on your computer.)"
          }
        }
      }
    },
    "  ● 正在播放": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "  ● Playing"
          }
        }
      }
    },
    " · 充电中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · Charging"
          }
        }
      }
    },
    "%@ tokens": {
      "shouldTranslate": false
    },
    "%@ · %lld 句。结束后可以在字幕记录窗口里查看、总结和保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld lines. After ending, you can review, summarize and save them in the Transcript window."
          }
        }
      }
    },
    "%@ → %@，其他语言 → %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@, other languages → %@"
